{
  "scripts": {
    "start": "wp-scripts start --webpack-copy-php",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "i18n-pot": "wp i18n make-pot . languages/3d-viewer.pot --exclude=\"src,zip,public,lib/bfields\"",
    "i18n-json": "wp i18n make-json languages/ --no-purge",
    "i18n-mo": "wp i18n make-mo languages/",
    "i18n": "npm run i18n-pot && npm run copy && npm run i18n-json && npm run i18n-mo",
    "copy": "cp ./languages/3d-viewer.pot ./languages/3d-viewer-en_US.po",
    "build": "wp-scripts build --webpack-copy-php && npm run i18n && find . -name '.DS_Store' -delete && npm run zip",
    "zip": "rm -f zip/3d-viewer.zip && zip -r zip/3d-viewer.zip 3d-viewer-block/ admin/ build/ inc languages lib public vendor 3d-viewer.php readme.txt composer.json uninstall.php -x 'lib/bfields/README.md' '*.map' '*.DS_Store'",
    "clean": "find . -name '.DS_Store' -type f -delete",
    "deploy": "gulp freemius-deploy",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:classic": "playwright test -c tests/e2e/playwright.config.ts --project=admin-classic",
    "test:e2e:modern": "playwright test -c tests/e2e/playwright.config.ts --project=admin-modern",
    "test:e2e:crossmode": "playwright test -c tests/e2e/playwright.config.ts --project=crossmode",
    "test:e2e:headed": "playwright test -c tests/e2e/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test -c tests/e2e/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report tests/e2e/artifacts/report",
    "test:e2e:gallery": "node tests/e2e/scripts/make-gallery.mjs && open tests/e2e/artifacts/gallery.html",
    "test": "playwright test -c tests/e2e/playwright.config.ts",
    "test:headed": "playwright test -c tests/e2e/playwright.config.ts --headed",
    "test:ui": "playwright test -c tests/e2e/playwright.config.ts --ui",
    "test:report": "playwright show-report tests/e2e/artifacts/report",
    "test:gallery": "node tests/e2e/scripts/make-gallery.mjs && open tests/e2e/artifacts/gallery.html"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@wordpress/element": "^6.40.0",
    "bp-utils": "^0.0.13",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/wordpress__block-editor": "^15.0.5",
    "@wordpress/api-fetch": "^7.56.0",
    "@wordpress/block-editor": "^14.21.0",
    "@wordpress/blocks": "^13.10.0",
    "@wordpress/components": "^28.13.0",
    "@wordpress/compose": "^7.27.0",
    "@wordpress/data": "^10.27.0",
    "@wordpress/i18n": "^5.26.0",
    "@wordpress/scripts": "^27.9.0",
    "@wp-playground/cli": "^3.1.15",
    "eslint-webpack-plugin": "^4.2.0",
    "gulp": "^5.0.1",
    "gulp-freemius-deploy": "^1.0.11",
    "typescript": "^5.9.3"
  }
}
